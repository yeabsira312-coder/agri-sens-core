# Copy this file to .env and fill in your values.
# The application works without any of these — they are all optional.

# User-Agent header sent to the NASA POWER API.
# Useful to identify your requests in server logs.
USER_AGENT=Mozilla/5.0 (AgriSensCore/1.0)

# Optional: Planetary Computer subscription key for higher-rate STAC requests.
# Leave blank to use the unauthenticated tier (sufficient for light use).
PC_SDK_SUBSCRIPTION_KEY=
