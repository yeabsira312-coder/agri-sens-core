# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build / distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
env.bak/
venv.bak/

# Logs — ignore all log files and dated log rotations
logs/*.log
logs/*.log.*
*.log

# Data — ignore contents but preserve directory structure via .gitkeep
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep

# Environment secrets
.env
# .env.example is committed intentionally — do not ignore it

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# macOS
.DS_Store

